# Root .env — SINGLE configuration file for all tools (except notify).
# Copy to `.env` at the repo root. `.env` is gitignored; this `.env.example` is the committed doc.
#
# Model: one single source. Each tool loads ONLY this file:
#     REPO_ROOT = Path(__file__).resolve().parents[3]      # tool in local/scripts/<tool>/
#     load_dotenv(REPO_ROOT / ".env", override=False)      # override=False → the CLI's own env wins
#
# OUTSIDE of this file: notify (its own .env + SOPS + systemd).
# Secrets go here (one single file) → chmod 600. Fill in the values marked <...>.

# ─── Shared / Observability ─────────────────────────────────────────────
PUSHGATEWAY_URL=http://localhost:9391
REPO_ROOT=/home/<user>/personal-agent-kit
PAK_INVOKED_BY=
LOG_LEVEL=INFO

# ─── memory_index (Qdrant + agent memory) ──────────────────────────────
# The kit's brain has ports of its own, the same on every machine: Qdrant on 7733 (7734 for
# gRPC, container memory-qdrant-7733) and the memory_service on 7800. Change them only when
# something else on this machine already holds them: QDRANT_PORT, MEMORY_SERVICE_PORT and the
# port inside MEMORY_SERVICE_URL together. The installer never adopts another checkout's Qdrant.
# On an installed kit a new QDRANT_PORT starts an empty Qdrant: take a `pak brain backup` first
# and restore it afterwards.
QDRANT_HOST=localhost
QDRANT_PORT=7733
QDRANT_COLLECTION=runbooks
QDRANT_API_KEY=
QDRANT_HTTPS=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SCORE_THRESHOLD=0.55
TOP_K=5
# DOCS_ROOT=<absolute path to docs/ — auto-detected if not set>
MEMORY_COLLECTION=agent_memory
# Personal (scope=user) lives in its OWN local collection, separate from MEMORY_COLLECTION
# (scope=shared) — a bulk operation on one never touches the other.
MEMORY_USER_COLLECTION=agent_memory_user
# Brain backups (bin/brain_backup.py): where the generations live, and which collections
# to snapshot (comma separated). Empty = ~/.pak/backups/brain and the kit's three collections.
PAK_BACKUP_ROOT=
MEMORY_BACKUP_COLLECTIONS=
MEMORY_SERVICE_URL=http://localhost:7800
MEMORY_SERVICE_PORT=7800
MEMORY_HEARTBEAT_SECONDS=60
# Interface the service listens on. Loopback by default: nothing else needs to reach it.
# MEMORY_SERVICE_HOST=127.0.0.1
# The brain page (http://localhost:<MEMORY_SERVICE_PORT>/brain/) reads this file: one line per
# move of a session. Empty = local/scripts/a2a/logs/brain_events.jsonl in the checkout.
# BRAIN_EVENTS_LOG=
# Characters of memory a session starts with (the brief). Default 3500.
# MEMORY_BRIEF_MAX_CHARS=3500
# How dense and lexical search merge: convex (default, MEMORY_FUSION_ALPHA weighs the dense side),
# adaptive (leans on words when the query names something rare) or rrf.
# evals/memory_benchmark.py measures them all: docs/memory-benchmark.md.
# MEMORY_FUSION=convex
# MEMORY_FUSION_ALPHA=0.7
# Memory service auth (local). Identity is derived from the token.
# e.g. tok_alice:alice,tok_bob:bob
MEMORY_USER_TOKENS=
MEMORY_ADMIN_TOKEN=
MEMORY_ALLOW_NO_AUTH=false   # true ONLY locally

# A2A engine (local/scripts/a2a/a2a.py + local/hooks/a2a_inbox.py)
# OPENCODE_SERVER_URL: a specific OpenCode server (e.g. http://127.0.0.1:4096); empty = the
#   CLI's background service, where the live sessions live.
# OPENCODE_BIN: the opencode binary (default: whatever is in PATH).
# OPENCODE_SESSION_ID / BRAIN_ORIGIN / A2A_EMITTER: who is calling (the delegate's emitter
#   identity chain); CLAUDE_SESSION_ID: the inbox hook's fallback session identity.
OPENCODE_SERVER_URL=
OPENCODE_BIN=
OPENCODE_SESSION_ID=
BRAIN_ORIGIN=
A2A_EMITTER=
CLAUDE_SESSION_ID=
# client token (one of MEMORY_USER_TOKENS)
MEMORY_SERVICE_TOKEN=

# ─── Reports (excel + pdf) ──────────────────────────────────────────────────
# Shared by both generators: same OUTPUT_DIR/MIRROR_DIR (a single value).
OUTPUT_DIR=/home/<user>/reports
MIRROR_DIR=/home/<user>/personal-agent-kit/temp

# ─── monitoring (Grafana, docker-compose) ────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<grafana-admin-password>

# ─── evals (evals/run_evals.py) ──────────────────────────────────────────────
EVAL_MODEL=sonnet
EVAL_THRESHOLD=0.8

# ─── Guard Stage 2 (bin/decision.py, optional) ──────────────────────────────────
# OpenRouter key for the decision engine. Empty = Stage 2 off: the rules still decide, and every
# challenge asks the human. `python3 bin/auto_guard.py --status` shows which one is on.
OPENROUTER_API_KEY=
# The engine's model, read from the process environment (default in bin/decision.py).
# PAK_DECISION_MODEL=openrouter/~typesafe/jev-latest

# ─── Quarantine (bin/quarantine.py) ──────────────────────────────────────────────
# Where removed files go, read from the process environment. Default: ~/.pak/quarantine
# QUARANTINE_ROOT=

# ─── Lessons and the autonomous worker (pak lessons, pak task) ─────────────────────
# Read from the process environment. Defaults: ~/.pak/lessons.jsonl and ~/.pak/tasks
# PAK_LESSONS=
# PAK_TASKS_DIR=
# The worker's container logs in with one of these, never with your login on this machine:
# an API key, or the token `claude setup-token` prints for a Claude subscription.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# Destinations the container may reach besides the model API, as host:port, comma-separated
# (bin/egress.py). Every refused one is in the task's egress.jsonl. Example: pypi.org:443
# PAK_WORKER_EGRESS=

# ─── Snapshots (bin/snapshot.py) ─────────────────────────────────────────────────
# Read from the process environment. Where the copies live (default ~/.pak/snapshots), and the
# size in MB past which a file is left out of them (default 20).
# PAK_SNAPSHOTS_DIR=
# PAK_SNAPSHOT_MAX_FILE_MB=

# ─── TTS hook (.claude/hooks/tts_hook.py) ────────────────────────────────────
# Fully disables the hook (worker exits immediately, no synthesis or playback).
# Toggle with /tts (or /tts on|off). false = disabled (default if the variable is missing).
TTS_ENABLED=false
# Swappable engine — each one lives in .claude/hooks/tts_engines/<engine>.py and is
# registered in tts_engines/__init__.py (never an if in the hook). v1: edge-tts only.
TTS_ENGINE=edge-tts
# Active persona (Story B) — see .claude/hooks/persona.md. Empty = no rewriting,
# the cleaned text is spoken as-is (Story A behavior).
TTS_PERSONA=nova
# Fallback engine (Story C) — only tried if TTS_ENGINE fails at runtime (edge-tts
# depends on an unofficial endpoint, no SLA). chatterbox runs locally
# (local/scripts/chatterbox-tts-server, docker compose -f docker-compose-cpu.yml
# up -d) — slow on CPU, but the only one with no network dependency. Empty = no fallback.
TTS_FALLBACK_ENGINE=chatterbox
# bfloat16 optimization for the chatterbox engine (T3 in bf16 + autocast during inference) —
# off by default so it doesn't change behavior for anyone already running it. on/1/true =
# force it (assumes the hardware supports bf16); auto = only if
# torch.cuda.is_bf16_supported(); any other value (including empty) = off. See
# local/scripts/chatterbox-tts-server/engine.py.
TTS_BF16=off
# Global output language — Claude Code sends some of its own Notification messages
# hardcoded in English (e.g. "Claude is waiting for your input") regardless of the
# user's language. language_normalizer.py translates to this language when needed,
# inferring first with a local, free heuristic before falling back to the model.
TTS_LANGUAGE=en
