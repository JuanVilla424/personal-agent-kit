{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "memory": {
      "command": "${CLAUDE_PROJECT_DIR:-.}/.venv/bin/python3",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/bin/opencode/mcp_memory_server.py"]
    },
    "decision": {
      "command": "${CLAUDE_PROJECT_DIR:-.}/.venv/bin/python3",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/bin/decision_mcp.py"]
    }
  }
}
