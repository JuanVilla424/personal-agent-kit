[Unit]
Description=OpenCode Headless Server
After=network.target

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/personal-agent-kit
ExecStart=<opencode-bin> serve --port 4096 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
Environment=HOME=/home/<user>
Environment=PATH=/home/<user>/.npm-global/bin:/home/<user>/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
