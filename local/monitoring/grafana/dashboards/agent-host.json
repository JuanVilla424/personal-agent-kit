{
  "title": "Personal Agent Kit Host (agent-host)",
  "description": "Does the agent's server have headroom? USE method: utilization (CPU/RAM/disk), saturation (load/swap), and network of the host running the whole stack. Audience: operations.",
  "uid": "personal-agent-kit-host",
  "version": 5,
  "tags": [
    "personal-agent-kit"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "personal-agent-kit"
      ],
      "asDropdown": true,
      "title": "Boards",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "schemaVersion": 36,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 101,
      "title": "CPU now",
      "description": "Host's current CPU usage. Alerts at a sustained 90%.",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "CPU now",
          "instant": true
        }
      ],
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 102,
      "title": "RAM now",
      "description": "Host's memory in use. Alerts at a sustained 90%.",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "RAM now",
          "instant": true
        }
      ],
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 103,
      "title": "Disk now",
      "description": "Root filesystem in use (source: bot). Alerts at 85%.",
      "type": "gauge",
      "targets": [
        {
          "expr": "max(host_disk_used_percent)",
          "legendFormat": "Disk now",
          "instant": true
        }
      ],
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 1,
      "title": "CPU %",
      "description": "Agent server's CPU usage. Alerts at a sustained 90% for 10 min.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "cpu"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "lineInterpolation": "smooth",
            "gradientMode": "opacity"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 2,
      "title": "Load average",
      "description": "System load (1/5/15 min). Sustained above the core count indicates saturation.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_load1",
          "legendFormat": "load1"
        },
        {
          "expr": "node_load5",
          "legendFormat": "load5"
        },
        {
          "expr": "node_load15",
          "legendFormat": "load15"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "gradientMode": "opacity"
          }
        }
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 3,
      "title": "RAM",
      "description": "Host's memory used vs. total. Alerts at a sustained 90%.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used"
        },
        {
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "total"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 4,
      "title": "Network (bytes/s)",
      "description": "Host network traffic (excluding loopback).",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "rx {{device}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "tx {{device}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "gradientMode": "opacity"
          }
        }
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 5,
      "title": "Host uptime",
      "description": "Time since the server's last boot (WSL).",
      "type": "stat",
      "targets": [
        {
          "expr": "node_time_seconds - node_boot_time_seconds",
          "legendFormat": "uptime"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 0,
          "thresholds": {
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "green",
                "value": 3600
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 6,
      "title": "Swap used",
      "description": "Swap in use. Sustained growth = memory pressure (watch it; high RAM does alert).",
      "type": "stat",
      "targets": [
        {
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "swap"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2147483648
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 7,
      "title": "Root disk used %",
      "description": "Root filesystem usage (reported by the bot via shutil). Alerts at 85%.",
      "type": "stat",
      "targets": [
        {
          "expr": "max(host_disk_used_percent)",
          "legendFormat": "/"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "decimals": 1,
          "noValue": "Bot down (source: bot)",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 8,
      "title": "Root disk (bytes)",
      "description": "Root filesystem's used vs. total space.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(host_disk_used_bytes)",
          "legendFormat": "used"
        },
        {
          "expr": "max(host_disk_total_bytes)",
          "legendFormat": "total"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 4
      }
    }
  ]
}
