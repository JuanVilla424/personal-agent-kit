# Copy to .env and fill in values
# NEVER commit .env to git

# ─── Slack (outgoing webhook + bidirectional bot) ─────────────────────────────
# Incoming Webhook URL — notify() uses this for output
SLACK_WEBHOOK_URL=
# xoxb-... Bot OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=
# xapp-... App-level Token (Socket Mode — bidirectional)
SLACK_APP_TOKEN=
# CSV of the channel IDs the bot listens in. Empty = none: the bot is closed by default.
SLACK_CHANNEL_IDS=
# CSV of the Slack user IDs (U…) whose messages reach an agent. Empty = nobody.
SLACK_ALLOWED_USERS=

# ─── Claude CLI ──────────────────────────────────────────────────────────────
CLAUDE_BIN=<claude-bin>
CLAUDE_TIMEOUT=600                  # Max seconds per query (10 min)
CLAUDE_MAX_BUDGET_USD=1.00          # Cost cap per query
CLAUDE_MODEL=claude-sonnet-5-5         # Slack bot default (MODELS.md §3)
CLAUDE_FALLBACK_MODEL=claude-haiku-5-5
CLAUDE_MCP_CONFIG=/home/<user>/personal-agent-kit/local/scripts/notify/mcp.json
SANDBOX_DISABLED=0                  # 1 to bypass firejail

# ─── Bot behavior ────────────────────────────────────────────────────────────
CHUNK_SIZE_CHARS=2900               # Slack Block Kit section text max: 3000
STREAM_INTERVAL_MS=500              # Token streaming refresh interval
PROGRESS_UPDATE_SECONDS=60          # Fallback progress interval
QUEUE_TIMEOUT_SECONDS=300           # Maximum time in queue before dropping
POOL_SIZE=2                         # Subprocess pre-warm pool size
CACHE_TTL_SECONDS=3600              # Response cache TTL (1 hour)
SESSION_TTL_HOURS=24                # Thread session TTL
USER_MONTHLY_BUDGET_USD=50.0        # Monthly budget per user (cost_tracker)

# ─── Permissions and security ─────────────────────────────────────────────────
PERMISSIONS_FILE=/home/<user>/personal-agent-kit/local/scripts/notify/security/permissions.yaml
TOTP_KEY_FILE=/home/<user>/personal-agent-kit/local/scripts/notify/security/totp.secrets

# ─── Observability ────────────────────────────────────────────────────────────
METRICS_PORT=9090                   # Prometheus exporter port
HEALTH_PORT=9091                    # FastAPI health endpoint port
PUSHGATEWAY_URL=http://localhost:9391  # Point elsewhere only if you run this on more than one machine of your own
# Attribution label for pushed metrics (defaults to OS user)
PAK_INVOKED_BY=
LOG_LEVEL=INFO
PUSH_TIMEOUT_SECONDS=20             # Timeout for the push to Pushgateway (ops/metrics_push.py)
# TRACE_FILE=                       # Override the default <notify>/logs/traces.jsonl (ops/trace.py)
# NOTIFY_SILENT=                    # Internal flag (notify.py sets it to 1 to suppress output) — don't set by hand

# ─── Backup ──────────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/agent-bot
# optional: S3 bucket for remote backups
BACKUP_S3_BUCKET=

# ─── Voice TTS ───────────────────────────────────────────────────────────────
PIPER_BIN=piper                     # piper TTS binary path
# Path to .onnx voice model (optional)
PIPER_VOICE_MODEL=

# ─── Repo ────────────────────────────────────────────────────────────────────
REPO_ROOT=/home/<user>/personal-agent-kit
