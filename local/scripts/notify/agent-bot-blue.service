[Unit]
Description=Personal Agent Kit Slack Bot (Party Mode) — BLUE
After=network-online.target
Wants=network-online.target
OnFailure=agent-bot-alert.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=<user>
Group=<user>
WorkingDirectory=/home/<user>/personal-agent-kit/local/scripts/notify
EnvironmentFile=/home/<user>/personal-agent-kit/local/scripts/notify/.env
Environment="PYTHONUNBUFFERED=1"
Environment="DEPLOY_COLOR=blue"
Environment="PATH=<claude-dir>:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/<user>/personal-agent-kit/local/scripts/notify/venv/bin/python3 bot.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5
KillSignal=SIGKILL

MemoryMax=1G
MemoryHigh=800M
CPUQuota=200%
TasksMax=512

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
